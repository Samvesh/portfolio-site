# Google Service Account credentials (from your service-account JSON key file)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Sheet ID (the long string in the sheet URL between /d/ and /edit)
SHEET_ID=your-google-sheet-id-here

# Frontend origin allowed to call this API (no trailing slash)
ALLOWED_ORIGIN=https://yourusername.github.io

# Port (Render sets this automatically; default 3000 for local dev)
PORT=3000
